# ===== 部署 =====
# compose 中 Caddy 使用的域名，需先把 DNS 解析到服务器
SITE_DOMAIN=blog.example.com
# 保留的历史版本数（含当前版本）
KEEP_REVISIONS=10

# ===== 站点 =====
SITE_TITLE=Sylva
SITE_SUBTITLE=Knowledge, Articles & Inspiration
SITE_DESCRIPTION=由 Sylva 发布的文章。
# 侧栏 GitHub 图标链接；留空则不显示
SITE_GITHUB_URL=
# 是否允许搜索引擎收录，默认不允许
SITE_ALLOW_INDEXING=false

# ===== 关于我（不设置时使用内置默认资料）=====
# ABOUT_DISPLAY_NAME=CiZai
# ABOUT_ROLE_TITLE=Creative Dev & Visual Artist
# 段落之间用 \n\n 分隔
# ABOUT_INTRO=我是 CiZai，是一个普普通通的程序员。\n\n我的兴趣主要在 Coding / AI 方向。
# 列表用英文逗号分隔
# ABOUT_EXPERTISE=Frontend Architecture,AI 应用开发
# ABOUT_TOOLKIT=TypeScript,React,Bun
# ABOUT_QUOTE=Code is just another medium for painting dreams.
# 正文注记：style 可选 red/orange/green/teal/blue/purple/pink/yellow；设为空字符串表示不加注记
# ABOUT_ACCENTS=[{"phrase":"CiZai","style":"red","note":"yep, that's me"}]
# ABOUT_CONTACT_TEXT=想聊点什么？随时
# ABOUT_CONTACT_LABEL=message me
# ABOUT_CONTACT_HREF=mailto:me@example.com
# 头像：http(s) 地址或容器内文件路径；留空使用内置头像
# ABOUT_AVATAR_URL=

# ===== 备案（在中国大陆服务器上使用自有域名时填写）=====
# FILING_ICP_NUMBER=京ICP备00000000号-1
# FILING_ICP_URL=https://beian.miit.gov.cn/
# FILING_PUBLIC_SECURITY_NUMBER=
# FILING_PUBLIC_SECURITY_URL=
